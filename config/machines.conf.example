# hostname -> machine label used in store directory names
#
# The left side accepts either `scutil --get LocalHostName` or `hostname -s`
# output; the scripts try both. The right side becomes the @suffix, so keep it
# short, stable and unique per machine.
# Copy to ~/.config/new-project/machines.conf and edit.

# examples
# my-macbook-pro.local = mac-a
# my-macbook-pro       = mac-a
# imac-7.local         = iMac-7
# imac-7               = iMac-7
