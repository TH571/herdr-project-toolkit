# Default paths for new-project / delete-project.
# install.sh writes this file to ~/.config/new-project/config.

# Work area root: local disk only, never inside iCloud / Dropbox / OneDrive.
WORK_ROOT=/Users/you/Projects

# Store area root: may live on a synced disk. Directory names automatically
# get an @<machine-label> suffix, so machines never overwrite each other.
STORE_ROOT=/Users/you/Projects-archive
