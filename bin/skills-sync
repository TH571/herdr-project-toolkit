#!/usr/bin/env bash
# skills-sync — copy every skill in ~/.agents/skills to all agent skill directories.
# Source of truth: ~/.agents/skills/<name> (omp reads it directly).
set -euo pipefail

VERSION="2.0.0"
SRC_ROOT="$HOME/.agents/skills"

[ -d "$SRC_ROOT" ] || { printf 'error: source directory not found: %s\n' "$SRC_ROOT" >&2; exit 1; }

# Claude follows symlinks fine, so it gets links; the rest get real copies.
LINK_DIRS=("$HOME/.claude/skills")
COPY_DIRS=(
  "$HOME/.qwen/skills"
  "$HOME/.codex/skills"
  "$HOME/.opencode/skills"
  "$HOME/.workbuddy/skills"
  "$HOME/.codebuddy/skills"
  "$HOME/.commandcode/skills"
  "$HOME/.dsh/skills"
  "$HOME/.hermes/skills"
  "$HOME/.minimax/skills"
  "$HOME/.qoder-cn/skills"
  "$HOME/.reasonix/skills"
  "$HOME/.trae-cn/skills"
)

h() { md5 -q "$1" 2>/dev/null || md5sum "$1" | awk '{print $1}'; }

WANT=("$@")
want_match() {
  [ "${#WANT[@]}" -eq 0 ] && return 0
  for w in "${WANT[@]}"; do [ "$w" = "$1" ] && return 0; done
  return 1
}

total=0; bad=0
for SRC in "$SRC_ROOT"/*/; do
  SRC="${SRC%/}"
  NAME="$(basename "$SRC")"
  [ -f "$SRC/SKILL.md" ] || continue
  want_match "$NAME" || continue
  total=$((total+1))
  printf '\n[%s]\n' "$NAME"

  for d in "${LINK_DIRS[@]}"; do
    mkdir -p "$d"
    rm -rf "$d/$NAME"
    ln -s "../../.agents/skills/$NAME" "$d/$NAME"
    printf '  symlink  %s\n' "$(printf '%s' "$d" | sed "s|$HOME|~|")"
  done

  _copied=0
  for d in "${COPY_DIRS[@]}"; do
    [ -d "$d" ] || continue
    rm -rf "$d/$NAME"
    cp -R "$SRC" "$d/$NAME"
    _copied=$((_copied+1))
  done
  printf '  copies   %s\n' "$_copied"
done

printf '\n=== consistency check ===\n'
for SRC in "$SRC_ROOT"/*/; do
  SRC="${SRC%/}"
  NAME="$(basename "$SRC")"
  [ -f "$SRC/SKILL.md" ] || continue
  want_match "$NAME" || continue
  _h=$(h "$SRC/SKILL.md")
  _n=0
  for d in "${LINK_DIRS[@]}" "${COPY_DIRS[@]}"; do
    f="$d/$NAME/SKILL.md"
    [ -f "$f" ] || continue
    _n=$((_n+1))
    if [ "$(h "$f")" != "$_h" ]; then
      printf '  !! %s differs: %s\n' "$NAME" "$f"
      bad=$((bad+1))
    fi
  done
  printf '  %-18s %2s installs  hash %s\n' "$NAME" "$_n" "${_h:0:8}"
done

printf '\n%s skill(s)' "$total"
[ "$bad" -eq 0 ] && printf ', all consistent\n' || { printf ', %s mismatch(es)\n' "$bad"; exit 1; }
printf 'Note: Codex does not read SKILL.md (it uses ~/.codex/AGENTS.md); WorkBuddy needs a new chat to refresh its list.\n'
