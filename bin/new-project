#!/usr/bin/env bash
# new-project.sh — scaffold a project with separate work area and store area.
# Design: the work area can be deleted at any time (git is the safety net);
#         the store area is the single place deliverables live.
set -euo pipefail

VERSION="2.0.0"
PROG="$(basename "$0")"

CONF="${NEWPROJECT_CONFIG:-$HOME/.config/new-project/config}"
conf_get() {
  [ -f "$CONF" ] || return 0
  awk -F'=' -v k="$1" '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    { kk=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,"",kk);
      if (kk==k) { v=substr($0, index($0,"=")+1); gsub(/^[[:space:]]+|[[:space:]]+$/,"",v); print v; exit } }
  ' "$CONF"
}

WORK_ROOT="${NEWPROJECT_WORK_ROOT:-$(conf_get WORK_ROOT)}"
[ -n "$WORK_ROOT" ] || WORK_ROOT="$HOME/Projects"
STORE_ROOT="${NEWPROJECT_STORE_ROOT:-$(conf_get STORE_ROOT)}"
[ -n "$STORE_ROOT" ] || STORE_ROOT="$HOME/Projects-archive"
MACHINES_CONF="${NEWPROJECT_MACHINES_CONF:-$HOME/.config/new-project/machines.conf}"
HOSTNAME_RAW="$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || echo unknown)"

# hostname -> machine label (used in the store dir name and in OWNER)
conf_lookup() {
  _h="$1"
  [ -f "$MACHINES_CONF" ] || { printf '%s' "$_h"; return; }
  _v="$(awk -F'=' -v h="$_h" '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    { k=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,"",k);
      if (k==h) { v=substr($0, index($0,"=")+1); gsub(/^[[:space:]]+|[[:space:]]+$/,"",v); print v; exit } }
  ' "$MACHINES_CONF")"
  if [ -n "${_v:-}" ]; then printf '%s' "$_v"; else printf '%s' "$_h"; fi
}

OWNER="${NEWPROJECT_OWNER:-${NEWPROJECT_MACHINE:-$(conf_lookup "$HOSTNAME_RAW")}}"

NAME=""
DO_GIT=0
DRY=0
READONLY=0
FORCE=0
MACHINE_SUFFIX=1
SUFFIX_SEP="${NEWPROJECT_SUFFIX_SEP:-@}"
SUFFIX_OVERRIDE="${NEWPROJECT_SUFFIX:-}"
MAKE_SPACE=1

usage() {
  cat <<EOF
$PROG $VERSION — scaffold a project with separate work and store areas

Usage:
  $PROG <project-name> [options]

Options:
  --work-root <dir>    Root for work areas (default: ${WORK_ROOT})
  --store-root <dir>   Root for store areas (default: ${STORE_ROOT})
  --machine <label>    Machine label (default: ${OWNER}; resolved from hostname
                       ${HOSTNAME_RAW} via ${MACHINES_CONF})
  --suffix <text>      Override the store dir suffix (default: machine label)
  --suffix-sep <char>  Suffix separator (default: @)
  --no-machine-suffix  Do not append a machine suffix (machines will collide)
  --git                Run git init in the work area
  --space              Create a Herdr space pointing at the work area (default)
  --no-space           Skip Herdr space creation
  --readonly           Make the store area read-only after creation
  --dry-run            Print what would be created, write nothing
  --force              Fill in missing files only (never overwrites)
  -h, --help           Show this help
  -V, --version        Show version

Layout:
  work area   \$WORK_ROOT/<project>/                src/ tmp/ logs/ AGENTS.md .gitignore PROGRESS.md .claude/settings.json
  store area  \$STORE_ROOT/<project>@<machine>/     OWNER

Environment:
  NEWPROJECT_WORK_ROOT / NEWPROJECT_STORE_ROOT / NEWPROJECT_CONFIG
  NEWPROJECT_MACHINE or NEWPROJECT_OWNER (machine label)
  NEWPROJECT_MACHINES_CONF (hostname -> label map)
  NEWPROJECT_SUFFIX / NEWPROJECT_SUFFIX_SEP

Examples:
  $PROG my-project --git
  $PROG my-project --dry-run
EOF
}

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -V|--version) echo "$PROG $VERSION"; exit 0 ;;
    --work-root) [ $# -ge 2 ] || die "--work-root needs a value"; WORK_ROOT="$2"; shift 2 ;;
    --store-root) [ $# -ge 2 ] || die "--store-root needs a value"; STORE_ROOT="$2"; shift 2 ;;
    --owner|--machine) [ $# -ge 2 ] || die "$1 needs a value"; OWNER="$2"; shift 2 ;;
    --suffix) [ $# -ge 2 ] || die "--suffix needs a value"; SUFFIX_OVERRIDE="$2"; shift 2 ;;
    --suffix-sep) [ $# -ge 2 ] || die "--suffix-sep needs a value"; SUFFIX_SEP="$2"; shift 2 ;;
    --no-machine-suffix) MACHINE_SUFFIX=0; shift ;;
    --git) DO_GIT=1; shift ;;
    --space) MAKE_SPACE=1; shift ;;
    --no-space) MAKE_SPACE=0; shift ;;
    --readonly) READONLY=1; shift ;;
    --dry-run) DRY=1; shift ;;
    --force) FORCE=1; shift ;;
    -*) die "unknown option: $1 (see --help)" ;;
    *)
      [ -z "$NAME" ] || die "only one project name allowed"
      NAME="$1"; shift ;;
  esac
done

[ -n "$NAME" ] || { usage; exit 1; }
case "$NAME" in
  */*) die "project name must not contain a slash" ;;
  .*) die "project name must not start with a dot" ;;
esac
[ "$NAME" = "." ] && die "invalid project name"

# machine suffix: each machine gets its own store dir, so syncing never collides
MACHINE="$(printf '%s' "$OWNER" | sed 's#[/:]#-#g; s/[[:space:]]/-/g; s/-\{2,\}/-/g; s/^-//; s/-$//')"
SUFFIX_TEXT="${SUFFIX_OVERRIDE:-$MACHINE}"
if [ "$MACHINE_SUFFIX" -eq 1 ] && [ -n "$SUFFIX_TEXT" ]; then
  STORE_NAME="$NAME${SUFFIX_SEP}${SUFFIX_TEXT}"
else
  STORE_NAME="$NAME"
fi

WORK="$WORK_ROOT/$NAME"
STORE="$STORE_ROOT/$STORE_NAME"
TODAY="$(date '+%Y-%m-%d')"

# warn when a path sits inside a cloud sync folder
warn_sync() {
  case "$1" in
    *"iCloud"*|*"CloudStorage"*|*"Dropbox"*|*"OneDrive"*|*"Google Drive"*|*"Nutstore"*|*"Nextcloud"*)
      printf 'warning: %s\n' "$2" >&2 ;;
  esac
}
warn_sync "$WORK" "work area $WORK is inside a sync folder; two machines writing there will produce conflict copies."
if [ "$MACHINE_SUFFIX" -eq 0 ]; then
  warn_sync "$STORE" "store area $STORE is inside a sync folder and the machine suffix is disabled; machines will share one directory."
fi

if [ $DRY -eq 1 ]; then
  info "=== dry run (nothing written) ==="
  info "work area: $WORK"
  info "  will create src/ tmp/ logs/"
  info "  will write AGENTS.md / .gitignore / PROGRESS.md / .claude/settings.json"
  [ $DO_GIT -eq 1 ] && info "  will run git init"
  if [ $MAKE_SPACE -eq 1 ]; then
    info "  will create Herdr space: $NAME (folder=$WORK)"
  fi
  info "store area: $STORE"
  if [ "$MACHINE_SUFFIX" -eq 1 ]; then
    info "  dir name carries the machine label: ${STORE_NAME} (another machine would use ${NAME}${SUFFIX_SEP}<its label>)"
  fi
  info "  will write OWNER (machine: ${OWNER})"
  [ $READONLY -eq 1 ] && info "  will run chmod -R a-w"
  exit 0
fi

if [ -e "$WORK" ] || [ -e "$STORE" ]; then
  if [ $FORCE -eq 0 ]; then
    die "already exists: $WORK or $STORE (use --force to fill in missing files; nothing is overwritten)"
  fi
  info "directory exists, --force mode: filling in missing files only"
fi

mkdir -p "$WORK/src" "$WORK/tmp" "$WORK/logs" "$STORE"

# ---------- AGENTS.md ----------
AGENTS="$WORK/AGENTS.md"
if [ -e "$AGENTS" ]; then
  info "skip (exists): AGENTS.md"
else
  cat > "$AGENTS" <<AGENTSEOF
# Project conventions · $NAME

> Generated by \`new-project\` on ${TODAY}, owner machine: ${OWNER}.
> Claude / Codex / Qwen / omp / opencode all read this file at startup.

## 1. Two areas

| Area | Path | What goes there | Lifetime |
|---|---|---|---|
| Work area | \`$WORK\` | code, drafts, logs, caches, intermediate data | delete whenever; deliverables are already in the store |
| **Store area** | \`$STORE\` | **all deliverables, write here directly** | permanent, synced/backed up |

## 2. Hard rules (highest first)

1. **Write a deliverable straight into the store area** \`$STORE/\`. Do not write it into the work area first, then ask the user, then copy.
2. **Never ask** "is this a deliverable?", "should I save this to the store?", "do you want me to archive it?". Decide using section 3. If unsure, write it to \`_pending/\` inside the store area and move on. Do not interrupt the user.
3. Process files (drafts, logs, caches, intermediate data, throwaway scripts, error output) go only to \`src/\`, \`tmp/\`, \`logs/\`.
4. Keep meaningful subdirectories and file names in the store area; no \`untitled.md\`, no \`new file 2.txt\`.
5. Never write \`.git\`, \`node_modules\`, \`.venv\`, caches or any credential file into the store area.

## 3. Deliverable rules (follow these, do not ask)

**Deliverable → write directly to \`$STORE/\`:**

| Type | Typical form |
|---|---|
| Documents / reports | finished \`.md\`, \`.docx\`, \`.pdf\`, \`.txt\` — reports, proposals, minutes, guides |
| Data tables | \`.xlsx\`, \`.csv\`, \`.numbers\` result tables, inventories, ledgers |
| Slides / charts | \`.pptx\`, \`.key\`, exported \`.png\`, \`.jpg\`, \`.svg\` |
| Ship-ready pages / programs | finished \`.html\`, packaged binaries, installers |
| Reusable tools | scripts other people are meant to run (one-off scripts are not deliverables) |

**Not a deliverable → keep in the work area:**

- drafts, discarded versions, experiments, temporary comparisons
- logs, caches, \`__pycache__\`, \`node_modules\`, \`.venv\`
- intermediate data, downloaded raw material, extracted temp dirs
- one-off migration/debug scripts

**When unsure:** write it to \`$STORE/_pending/\` first and let the human decide later. Storing too much is better than asking.

## 4. Wrap-up

\`\`\`sh
date '+%Y-%m-%d done' > DONE    # mark the project finished
\`\`\`

Deliverables are already in the store area; once the work area has nothing left to keep, delete the whole directory (push git first if you use it).
**Do not move the work area**: agent conversation history is keyed by the absolute cwd, so \`--continue\` will not find old sessions after a move.
AGENTSEOF
  info "wrote: AGENTS.md"
fi

# ---------- .gitignore ----------
GI="$WORK/.gitignore"
if [ -e "$GI" ]; then
  info "skip (exists): .gitignore"
else
  cat > "$GI" <<'GIEOF'
# local agent config (never commit)
.claude/settings.local.json
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v3/
.aider.tags.cache.*/

# build and runtime artefacts
__pycache__/
.pytest_cache/
.venv/
node_modules/
dist/
build/
*.log
*.tmp
.DS_Store

# local temp and completion marker
tmp/
logs/
DONE
GIEOF
  info "wrote: .gitignore"
fi

# ---------- Claude extra writable dir (avoids repeated permission prompts) ----------
CL="$WORK/.claude/settings.json"
if [ -e "$CL" ]; then
  info "skip (exists): .claude/settings.json"
else
  mkdir -p "$WORK/.claude"
  printf '{\n  "permissions": {\n    "additionalDirectories": ["%s"]\n  }\n}\n' "$STORE" > "$CL"
  info "wrote: .claude/settings.json (grants write access to the store area)"
fi

# ---------- PROGRESS.md ----------
PG="$WORK/PROGRESS.md"
if [ -e "$PG" ]; then
  info "skip (exists): PROGRESS.md"
else
  cat > "$PG" <<PGEOF
# $NAME

> Cross-session state. Three sections, not a diary.

## Done
-

## Next
-

## Blocked
-
PGEOF
  info "wrote: PROGRESS.md"
fi

# ---------- OWNER ----------
OW="$STORE/OWNER"
if [ -e "$OW" ]; then
  info "skip (exists): OWNER"
else
  cat > "$OW" <<OWEOF
machine: $OWNER
hostname: $HOSTNAME_RAW
created: $TODAY
store_dir: $STORE_NAME
note: this directory is written by $OWNER only. Another machine uses "${NAME}${SUFFIX_SEP}<its label>" under the same store root, so the two never overwrite each other. Merge manually when both sides produced files.
OWEOF
  info "wrote: store OWNER (machine: ${OWNER}, dir ${STORE_NAME})"
fi

# ---------- git ----------
if [ $DO_GIT -eq 1 ]; then
  if [ -d "$WORK/.git" ]; then
    info "skip (already a git repo): .git"
  else
    git -C "$WORK" init -q
    info "ran: git init"
  fi
fi

if [ $READONLY -eq 1 ]; then
  chmod -R a-w "$STORE"
  info "ran: chmod -R a-w on the store area (restore with chmod -R u+w)"
fi

# ---------- Herdr space (folder cannot be changed later, so set it now) ----------
if [ $MAKE_SPACE -eq 1 ]; then
  if command -v herdr-app >/dev/null 2>&1; then
    _exist=0
    if herdr-app ls 2>/dev/null | python3 -c '
import json,sys
name = sys.argv[1]
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
sys.exit(0 if any(s.get("name") == name for s in d.get("spaces", [])) else 1)
' "$NAME" 2>/dev/null; then
      _exist=1
    fi
    if [ "$_exist" -eq 1 ]; then
      info "Herdr space already exists, skipped: ${NAME}"
    elif _out="$(herdr-app do space.new --name "$NAME" --folder "$WORK" 2>&1)"; then
      info "created Herdr space: ${NAME} (folder=${WORK})"
    else
      info "warning: could not create the Herdr space (the work area is fine). Retry manually:"
      info "    herdr-app do space.new --name \"$NAME\" --folder \"$WORK\""
      printf '%s\n' "$_out" | head -5 | sed 's/^/    /'
    fi
  else
    info "warning: herdr-app not found, skipped space creation"
  fi
fi

info ""
info "=== done ==="
info "work area:  $WORK"
info "  |- src/ tmp/ logs/    process files only"
info "store area: $STORE"
if [ "$MACHINE_SUFFIX" -eq 1 ]; then
  info "  (dir name carries the machine label; another machine writes ${NAME}${SUFFIX_SEP}<its label>)"
fi
info ""
info "next:"
info "  cd \"$WORK\""
info "  write deliverables straight into the store area; do not ask the user what counts as one (see AGENTS.md section 3)"
info "  Claude is pre-authorised via .claude/settings.json; other agents use --add-dir"
