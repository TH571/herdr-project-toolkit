#!/usr/bin/env bash
# delete-project.sh — delete a project: work area + store area + Herdr space.
# Safety: never rm. Both directories are moved into a local trash folder, and
#         nothing happens without an explicit --yes.
set -euo pipefail

VERSION="2.0.0"
CONF="${DELPROJ_CONFIG:-$HOME/.config/new-project/config}"
conf_get() {
  [ -f "$CONF" ] || return 0
  awk -F'=' -v k="$1" '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    { kk=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,"",kk);
      if (kk==k) { v=substr($0, index($0,"=")+1); gsub(/^[[:space:]]+|[[:space:]]+$/,"",v); print v; exit } }
  ' "$CONF"
}

WORK_ROOT="${DELPROJ_WORK_ROOT:-$(conf_get WORK_ROOT)}"
[ -n "$WORK_ROOT" ] || WORK_ROOT="$HOME/Projects"
STORE_ROOT="${DELPROJ_STORE_ROOT:-$(conf_get STORE_ROOT)}"
[ -n "$STORE_ROOT" ] || STORE_ROOT="$HOME/Projects-archive"
MACHINES_CONF="${DELPROJ_MACHINES_CONF:-$HOME/.config/new-project/machines.conf}"
HOSTNAME_RAW="$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || echo unknown)"

TARGET=""; YES=0; DRY=0; KEEP_SPACE=0; FORCE_INSIDE=0

usage() {
  cat <<EOF
delete-project $VERSION — delete a project's work area, store area and Herdr space

Usage:
  delete-project <project-name|work-area-path> [options]

Options:
  --yes           Actually do it (without it, only a report is printed)
  --dry-run       Same as omitting --yes
  --keep-space    Keep the Herdr space (default closes it, ending its terminals)
  --force-inside  Allow running from inside the project directory (not advised)
  -h, --help

Safety:
  - no rm: both directories are moved to $WORK_ROOT/.deleted/<timestamp>-<project>/
  - the report lists size, file count, uncommitted git changes, DONE marker, terminal count
  - only the current machine's store dir (<project>@<label>) is touched

Restore:
  mv "$WORK_ROOT/.deleted/<timestamp>-<project>/work"  "$WORK_ROOT/<project>"
  mv "$WORK_ROOT/.deleted/<timestamp>-<project>/store" "$STORE_ROOT/<project>@<label>"
EOF
}

info() { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -V|--version) echo "delete-project $VERSION"; exit 0 ;;
    --yes) YES=1; shift ;;
    --dry-run) DRY=1; shift ;;
    --keep-space) KEEP_SPACE=1; shift ;;
    --force-inside) FORCE_INSIDE=1; shift ;;
    -*) printf 'unknown option: %s\n' "$1" >&2; exit 1 ;;
    *) TARGET="$1"; shift ;;
  esac
done

[ -n "$TARGET" ] || { usage; exit 1; }

conf_lookup() {
  _h="$1"
  [ -f "$MACHINES_CONF" ] || { printf '%s' "$_h"; return; }
  _v="$(awk -F'=' -v h="$_h" '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    { k=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,"",k);
      if (k==h) { v=substr($0, index($0,"=")+1); gsub(/^[[:space:]]+|[[:space:]]+$/,"",v); print v; exit } }
  ' "$MACHINES_CONF")"
  if [ -n "${_v:-}" ]; then printf '%s' "$_v"; else printf '%s' "$_h"; fi
}
MACHINE="$(conf_lookup "$HOSTNAME_RAW")"
MACHINE="$(printf '%s' "$MACHINE" | sed 's#[/:]#-#g; s/[[:space:]]/-/g; s/-\{2,\}/-/g')"

case "$TARGET" in
  */*) WORK="${TARGET%/}"; NAME="$(basename "$WORK")" ;;
  *) NAME="$TARGET"; WORK="$WORK_ROOT/$NAME" ;;
esac
STORE="$STORE_ROOT/${NAME}@${MACHINE}"
LEGACY_STORE="$STORE_ROOT/$NAME"

[ -d "$WORK" ] || [ -d "$STORE" ] || {
  printf 'error: no such project %s\n  work area:  %s\n  store area: %s\n' "$NAME" "$WORK" "$STORE" >&2
  exit 1
}

# Guard: moving the cwd away and closing its space will kill the calling terminal
if [ "$KEEP_SPACE" -eq 0 ] && [ "$FORCE_INSIDE" -eq 0 ]; then
  case "$(pwd)" in
    "$WORK"|"$WORK"/*)
      warn "current directory is inside the project: $(pwd)"
      warn "the script moves that directory away and closes its space; this terminal would be killed mid-run."
      warn "run it from outside the project, or use --keep-space to delete the directories only."
      warn "to override anyway: --force-inside"
      printf '\nnothing done.\n'
      exit 2 ;;
  esac
fi

# Herdr space (match by name or by folder path)
SPACE_ID=""; SPACE_TERMS=0
if command -v herdr-app >/dev/null 2>&1; then
  _j="$(herdr-app ls 2>/dev/null || true)"
  if [ -n "$_j" ]; then
    eval "$(printf '%s' "$_j" | python3 -c '
import json,sys,os
name=sys.argv[1]; folder=os.path.normpath(sys.argv[2])
try: d=json.load(sys.stdin)
except Exception: sys.exit(1)
def norm(p): return os.path.normpath(p) if p else ""
for s in d.get("spaces",[]):
    if s.get("name")==name or norm(s.get("folder",""))==folder:
        n=sum(len(t.get("terminals",[])) for t in s.get("tabs",[]))
        print("SPACE_ID=%s" % s.get("id"))
        print("SPACE_TERMS=%d" % n)
        break
' "$NAME" "$WORK" 2>/dev/null || true)"
  fi
fi

size_of() { [ -d "$1" ] && du -sh "$1" 2>/dev/null | awk '{print $1}' || echo "-"; }
files_of() { [ -d "$1" ] && find "$1" -type f ! -path '*/.git/*' 2>/dev/null | wc -l | tr -d ' ' || echo 0; }

info "=== about to delete: $NAME ==="
printf '  work area   %-56s %8s  %5s files\n' "$WORK" "$(size_of "$WORK")" "$(files_of "$WORK")"
printf '  store area  %-56s %8s  %5s files\n' "$STORE" "$(size_of "$STORE")" "$(files_of "$STORE")"
if [ "$SPACE_ID" != "" ]; then
  printf '  Herdr space %-56s %s terminal(s), will be closed\n' "$NAME" "$SPACE_TERMS"
else
  printf '  Herdr space %-56s not found\n' "$NAME"
fi
[ -d "$LEGACY_STORE" ] && info "  note: an old-style directory exists at $LEGACY_STORE (left untouched)"

RISKS=0
if [ -d "$WORK/.git" ]; then
  _dirty="$(git -C "$WORK" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
  _commits="$(git -C "$WORK" rev-list --count HEAD 2>/dev/null || echo 0)"
  if [ "$_dirty" -gt 0 ]; then warn "work area has $_dirty uncommitted change(s)"; RISKS=$((RISKS+1)); fi
  if [ "$_commits" -eq 0 ]; then warn "git repo has no commits yet (no history to lose, but nothing saved)"; RISKS=$((RISKS+1)); fi
  if git -C "$WORK" remote 2>/dev/null | grep -q .; then
    _unpushed="$(git -C "$WORK" log --oneline @{u}.. 2>/dev/null | wc -l | tr -d ' ')"
    [ "${_unpushed:-0}" -gt 0 ] && { warn "$_unpushed commit(s) not pushed"; RISKS=$((RISKS+1)); }
  fi
fi
[ -f "$WORK/DONE" ] || { warn "no DONE marker in the work area; the project may be unfinished"; RISKS=$((RISKS+1)); }
[ "$SPACE_TERMS" -gt 0 ] && { warn "the space has $SPACE_TERMS live terminal(s); closing it ends them immediately"; RISKS=$((RISKS+1)); }

if [ "$YES" -eq 0 ] || [ "$DRY" -eq 1 ]; then
  info ""
  info "nothing done. Re-run with --yes to proceed:"
  if [ "$KEEP_SPACE" -eq 1 ]; then
    info "  delete-project \"$NAME\" --yes --keep-space"
  else
    info "  delete-project \"$NAME\" --yes"
  fi
  exit 0
fi

TS="$(date '+%Y%m%d-%H%M%S')"
TRASH_DIR="$WORK_ROOT/.deleted/${TS}-${NAME}"
mkdir -p "$TRASH_DIR"
info ""
info "moving to trash: $TRASH_DIR"
[ -d "$WORK" ] && mv "$WORK" "$TRASH_DIR/work"
[ -d "$STORE" ] && mv "$STORE" "$TRASH_DIR/store"

cat > "$TRASH_DIR/META.md" <<METAEOF
# Deleted: $NAME

- When: $(date '+%Y-%m-%d %H:%M:%S')
- Machine: $MACHINE (hostname $HOSTNAME_RAW)
- Herdr space: ${SPACE_ID:-none} (${SPACE_TERMS} terminal(s))
- Original work area: $WORK
- Original store area: $STORE
- Risk items flagged: $RISKS (uncommitted changes / no commits / no DONE / live terminals)

## Restore

\`\`\`sh
mv "$TRASH_DIR/work" "$WORK"
mv "$TRASH_DIR/store" "$STORE"
\`\`\`

## Purge

Once nothing is needed: rm -rf "$TRASH_DIR"
METAEOF

# Self-check: both paths must be gone
_miss=0
[ -d "$WORK" ] && { warn "work area still present: $WORK"; _miss=1; }
[ -d "$STORE" ] && { warn "store area still present: $STORE"; _miss=1; }
[ "$_miss" -eq 1 ] && warn "deletion did NOT complete, see errors above"

if [ "$KEEP_SPACE" -eq 0 ] && [ "$SPACE_ID" != "" ]; then
  _r="$(herdr-app do space.close --id "$SPACE_ID" --confirmed true 2>&1 || true)"
  sleep 1
  _left="$(herdr-app ls 2>/dev/null | python3 -c '
import json,sys
sid=sys.argv[1]
try: d=json.load(sys.stdin)
except Exception: print("unknown"); raise SystemExit
print("yes" if any(s.get("id")==sid for s in d.get("spaces",[])) else "no")
' "$SPACE_ID" 2>/dev/null || echo unknown)"
  if [ "$_left" = "no" ]; then
    info "closed Herdr space: $NAME (id $SPACE_ID)"
  else
    warn "space still present (id $SPACE_ID); close returned: $(printf '%s' "$_r" | tr -d '\n' | cut -c1-120)"
    warn "retry manually: herdr-app do space.close --id $SPACE_ID --confirmed true"
  fi
fi

info ""
info "=== done ==="
info "  trash:   $TRASH_DIR"
info "  restore: mv \"$TRASH_DIR/work\" \"$WORK\""
info "           mv \"$TRASH_DIR/store\" \"$STORE\""
info "  purge:   rm -rf \"$TRASH_DIR\""
